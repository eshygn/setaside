# SetAside runs with every value below left empty: PayPal and Gemini switch to their mock /
# recorded adapters and the status chips say so. Copy to .env.local and fill in what you have.

# PayPal sandbox REST app (developer.paypal.com → Apps & Credentials → Sandbox).
# Enable "Transaction search" on the app for live Transaction Search and Balances, and
# "Invoicing" for live invoices. PAYPAL_SECRET is accepted as an alias for the secret.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# A sandbox personal (buyer) account, used to pay through the PayPal buttons in the Invoices tab.
PAYPAL_SANDBOX_BUYER_EMAIL=

# Gemini API (free tier works): https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: comma-separated Gemini model ids to try first. Empty = gemini-3.8-flash, then
# gemini-2.5-flash, then recorded answers (see lib/ai/model.ts).
AI_MODEL=
# Optional: set to 1 to force recorded AI answers (no Gemini calls at all).
AI_OFFLINE=

# Optional: AG Grid Enterprise / AG Studio licence key. Without it everything works with a
# trial watermark.
AG_GRID_LICENSE_KEY=

# Bryntum is not used by SetAside; kept for parity with the hackathon environment.
BRYNTUM_EMAIL=
